{
  "buildCommand": "echo 'Static frontend'",
  "outputDirectory": "frontend",
  "rewrites": [
    { "source": "/api/edulab", "destination": "/api/edulab" },
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/", "destination": "/index.html" },
    { "source": "/((?!api/).*)", "destination": "/$1.html" }
  ]
}
